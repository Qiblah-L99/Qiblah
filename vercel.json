{
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/public-page?format=sitemap"
    },
    {
      "source": "/mosques/:slug",
      "destination": "/api/public-page?slug=:slug"
    },
    {
      "source": "/mosques/:slug/",
      "destination": "/api/public-page?slug=:slug"
    },
    {
      "source": "/mosque",
      "destination": "/mosque/index.html"
    },
    {
      "source": "/mosque/",
      "destination": "/mosque/index.html"
    },
    {
      "source": "/mosque/claim",
      "destination": "/mosque/claim.html"
    },
    {
      "source": "/mosque/claim/",
      "destination": "/mosque/claim.html"
    },
    {
      "source": "/register",
      "destination": "/register/index.html"
    },
    {
      "source": "/register/",
      "destination": "/register/index.html"
    },
    {
      "source": "/mosques",
      "destination": "/api/public-page?page=mosques"
    },
    {
      "source": "/mosques/",
      "destination": "/api/public-page?page=mosques"
    },
    {
      "source": "/services",
      "destination": "/seo/services.html"
    },
    {
      "source": "/services/",
      "destination": "/seo/services.html"
    },
    {
      "source": "/online",
      "destination": "/seo/prayer-rooms.html"
    },
    {
      "source": "/online/",
      "destination": "/seo/prayer-rooms.html"
    },
    {
      "source": "/prayer-rooms",
      "destination": "/seo/prayer-rooms.html"
    },
    {
      "source": "/prayer-rooms/",
      "destination": "/seo/prayer-rooms.html"
    },
    {
      "source": "/jumuah-times",
      "destination": "/seo/jumuah-times.html"
    },
    {
      "source": "/jumuah-times/",
      "destination": "/seo/jumuah-times.html"
    },
    {
      "source": "/jummah-times",
      "destination": "/seo/jumuah-times.html"
    },
    {
      "source": "/jummah-times/",
      "destination": "/seo/jumuah-times.html"
    },
    {
      "source": "/prayer-tablet/:slug",
      "destination": "/prayer-tablet.html"
    },
    {
      "source": "/display/:slug",
      "destination": "/display.html"
    }
  ],
  "functions": {
    "api/public-page.js": {
      "includeFiles": "{index.html,seo/mosques.html}"
    }
  }
}
